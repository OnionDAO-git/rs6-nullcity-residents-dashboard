{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@nullcity-dashboard/shared": ["../shared/src/index.ts"],
      "@nullcity-dashboard/observer": ["../observer/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../shared/src/**/*.ts", "../observer/src/**/*.ts"]
}
