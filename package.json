{
  "name": "rs6-nullcity-residents-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@nullcity-dashboard/server' --filter '@nullcity-dashboard/web' dev",
    "dev:server": "bun run --filter '@nullcity-dashboard/server' dev",
    "dev:web": "bun run --filter '@nullcity-dashboard/web' dev",
    "build": "bun run --filter '@nullcity-dashboard/shared' --filter '@nullcity-dashboard/observer' --filter '@nullcity-dashboard/server' --filter '@nullcity-dashboard/web' build",
    "check": "bun run --filter '*' check",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.1.16",
    "typescript": "^5.7.3"
  }
}
