# Null City residents dashboard — BFF environment.
# Copy to .env AND to packages/server/.env (bun loads the package-level file
# when running `bun run dev:server` from the workspace). Never commit .env.

# --- Serving (prod) -------------------------------------------------------
# Bind address. Default 127.0.0.1 (loopback only). Set 0.0.0.0 on Railway so
# the platform proxy can reach the BFF.
DASHBOARD_HOST=
# Listen port. Railway injects PORT; config reads DASHBOARD_PORT, then PORT,
# then 8787.
DASHBOARD_PORT=
# DEV ONLY. When set, browser routes 307-redirect to this Vite origin instead
# of serving packages/web/dist. MUST stay unset in production.
DASHBOARD_WEB_DEV_ORIGIN=
# Optional override of the built SPA directory (defaults to packages/web/dist).
DASHBOARD_WEB_DIST=

# --- In-container service targets -----------------------------------------
# AgentGateway websocket (server). In the all-in-one container: ws://127.0.0.1:43595
AGENT_GATEWAY_URL=
AGENT_GATEWAY_TOKEN=
# Raw RuneScape game gateway host:port behind the /rs ws proxy.
# In the all-in-one container: 127.0.0.1:43594
NULLCITY_RS_HOST=

# --- Shared volume roots (all dashboard reads + writes live here) ---------
# In the all-in-one container these point under /data so writes land on the
# same files the controller owns. patron-currency.json / patron-check-in.json
# write under NULLCITY_MEMORY_ROOT; resident-soul writes under NULLCITY_SOULS_ROOT
# (note: NOT under the memory root); resident-delete removes dirs under
# memory/logs/agent-logs roots.
NULLCITY_SERVER_ROOT=
NULLCITY_MEMORY_ROOT=
NULLCITY_LOGS_ROOT=
NULLCITY_AGENT_LOGS_ROOT=
NULLCITY_SOULS_ROOT=
NULLCITY_RESIDENT_SAVE_ROOT=
NULLCITY_BENCHMARK_ROOT=

# --- Stores ---------------------------------------------------------------
# City Postgres (BFF projections). Omit to run the in-memory store.
CITY_DATABASE_URL=
# Read-only landing Postgres (check-in sync). Optional. Unset in api session
# mode (the all-in-one container) — landing's DB is not exposed there.
LANDING_DATABASE_URL=

# --- Landing auth / OnionDAO ----------------------------------------------
# How session cookies are resolved into a user:
#   api  -> call landing's GET /api/public/session over HTTP (no DB dependency).
#   db   -> query landing Postgres directly (needs LANDING_DATABASE_URL).
#   auto -> db when LANDING_DATABASE_URL is set, else api. (default)
# api/auto-without-DB disables daily_checkins sync (no HTTP equivalent yet).
LANDING_SESSION_MODE=
LANDING_AUTH_BASE_URL=https://oniondao.dev
AUTH_COOKIE_NAME=session
CITY_PUBLIC_BASE_URL=http://localhost:8787
CITY_DEV_AUTH_ENABLED=
CITY_DEV_AUTH_EMAIL=
SESSION_COOKIE_SECURE=

# --- Onion consent-spend (explicit approval on landing) --------------------
# Base URL of landing's onion API; also the host of the user-facing approval
# surface /portal/onions the dashboard links to as `approvalUrl`.
ONION_API_BASE_URL=https://oniondao.dev
# Server-to-server API key for creating burn requests / reading their status.
ONION_EXTERNAL_API_KEY=
ONION_EXTERNAL_REQUESTER=nullcity-dashboard
# 'real' creates attendee-approved burn requests; default 'standin' keeps the
# labelled non-production AP debit for dev/demo.
ONION_SPEND_MODE=
# REQUIRED for the landing -> dashboard settlement webhook
# (POST /api/city/onion-callback). HMAC-SHA256 secret shared with landing per
# burn request; the callback is rejected (503/401) without it. Generate a
# strong random value per environment (e.g. `openssl rand -hex 32`) — there is
# no default and no shared prod value checked in anywhere.
ONION_CALLBACK_SECRET=
# Override the callback URL landing posts to (defaults to
# CITY_PUBLIC_BASE_URL + /api/city/onion-callback).
ONION_CALLBACK_URL=

# --- Null City control (City API) -------------------------------------------
NULLCITY_CITY_API_URL=
NULLCITY_CITY_API_TOKEN=
NULLCITY_LETTERS_BASE_URL=

# --- BFF performance --------------------------------------------------------
# TTL (ms) for the in-memory cache around expensive cross-resident
# aggregations on hot polled routes (/api/overview, /api/residents,
# /api/projector/overview, relationship summaries). 0 disables caching.
# Default: 15000.
DASHBOARD_CACHE_TTL_MS=

# --- Print bridge -----------------------------------------------------------
CITY_PRINT_BRIDGE_TOKEN=
