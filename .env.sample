# Null City residents dashboard — BFF environment.
# Copy to .env AND to packages/server/.env (bun loads the package-level file
# when running `bun run dev:server` from the workspace). Never commit .env.

# --- Stores ---------------------------------------------------------------
# City Postgres (BFF projections). Omit to run the in-memory store.
CITY_DATABASE_URL=
# Read-only landing Postgres (check-in sync). Optional.
LANDING_DATABASE_URL=

# --- Landing auth / OnionDAO ----------------------------------------------
LANDING_AUTH_BASE_URL=https://oniondao.dev
AUTH_COOKIE_NAME=session
CITY_PUBLIC_BASE_URL=http://localhost:8787
CITY_DEV_AUTH_ENABLED=
CITY_DEV_AUTH_EMAIL=
SESSION_COOKIE_SECURE=

# --- Onion consent-spend (explicit approval on landing) --------------------
# Base URL of landing's onion API; also the host of the user-facing approval
# surface /portal/onions the dashboard links to as `approvalUrl`.
ONION_API_BASE_URL=https://oniondao.dev
# Server-to-server API key for creating burn requests / reading their status.
ONION_EXTERNAL_API_KEY=
ONION_EXTERNAL_REQUESTER=nullcity-dashboard
# 'real' creates attendee-approved burn requests; default 'standin' keeps the
# labelled non-production AP debit for dev/demo.
ONION_SPEND_MODE=
# REQUIRED for the landing -> dashboard settlement webhook
# (POST /api/city/onion-callback). HMAC-SHA256 secret shared with landing per
# burn request; the callback is rejected (503/401) without it. Generate a
# strong random value per environment (e.g. `openssl rand -hex 32`) — there is
# no default and no shared prod value checked in anywhere.
ONION_CALLBACK_SECRET=
# Override the callback URL landing posts to (defaults to
# CITY_PUBLIC_BASE_URL + /api/city/onion-callback).
ONION_CALLBACK_URL=

# --- Null City control (City API) -------------------------------------------
NULLCITY_CITY_API_URL=
NULLCITY_CITY_API_TOKEN=
NULLCITY_LETTERS_BASE_URL=

# --- Print bridge -----------------------------------------------------------
CITY_PRINT_BRIDGE_TOKEN=
